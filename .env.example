# ==============================================================================
# AUDITMIND - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local to customize for production deployments.
# All fields have sensible local defaults out of the box.
# ==============================================================================

# 1. DATABASE & STORAGE (Optional - Defaults to persistent local SQLite)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# 2. AI INTELLIGENCE PROVIDER (Optional - Defaults to Grounded Local Compliance Engine)
# If provided, enables live OpenAI tool calling (gpt-4o). If omitted, AuditMind uses its
# built-in deterministic compliance tool-calling engine with real database retrieval.
OPENAI_API_KEY=your-openai-api-key-placeholder
OPENAI_MODEL=gpt-4o

# Optional persistent assistant memory powered by Hindsight.
# For Hindsight Cloud, use https://api.hindsight.vectorize.io and your Hindsight API key.
HINDSIGHT_API_KEY=your-hindsight-api-key-placeholder
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_PREFIX=auditmind

# 3. SCHEDULED MONITORING & CRON SECURITY
# Secret bearer token used to authenticate automated scheduled jobs to /api/cron/monitor
CRON_SECRET=your-secure-cron-secret-token-placeholder

# 4. ENVIRONMENT & APPLICATION URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
